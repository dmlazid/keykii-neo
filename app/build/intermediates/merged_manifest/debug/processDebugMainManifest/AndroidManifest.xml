<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="com.keykii.neo"
    android:versionCode="40"
    android:versionName="2.10" >

    <uses-sdk
        android:minSdkVersion="23"
        android:targetSdkVersion="35" />

    <application
        android:allowBackup="true"
        android:debuggable="true"
        android:extractNativeLibs="false"
        android:label="KeyKii Neo"
        android:theme="@style/Theme.KeyKii" >
        <activity
            android:name="com.keykii.neo.MainActivity"
            android:exported="true" >
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />

                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <service
            android:name="com.keykii.neo.KeyKiiService"
            android:exported="true"
            android:label="KeyKii Neo"
            android:permission="android.permission.BIND_INPUT_METHOD" >
            <intent-filter>
                <action android:name="android.view.InputMethod" />
            </intent-filter>

            <meta-data
                android:name="android.view.im"
                android:resource="@xml/method" />
        </service>

        <activity
            android:name="com.keykii.neo.SettingsActivity"
            android:exported="false" />
    </application>

</manifest>